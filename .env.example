GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional locally. If omitted, the app derives /api/auth/youtube/callback from the request host.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# Set this to your production Vercel URL, for example https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_COOKIE_SECRET=replace-with-a-long-random-string
